<?xml version="1.0" encoding="UTF-8"?>
<creative id="EI26-RTG-17-v2" status="ready" priority="P0" version="winner-pattern-v2">
  <meta>
    <campaign>Estate Inarrestabile 2026</campaign>
    <objective>LEADS</objective>
    <funnel-stage>retargeting</funnel-stage>
    <retarget-type>touch (landing visitors no opt-in)</retarget-type>
    <angle>FAQ Killer - 3 obiezioni, 3 risposte oneste</angle>
    <copy-framework>Objection Stack (winner pattern)</copy-framework>
    <design-template>winner-elena-v1</design-template>
  </meta>

  <design-brief output="canva-figma-static">
    <canvas><aspect-ratio>1:1</aspect-ratio><resolution>1080x1080</resolution><bg-base>brand-black</bg-base></canvas>
    <brand-tokens>
      <color name="brand-pink" hex="#FF0066"/>
      <color name="brand-black" hex="#000000"/>
      <color name="brand-white" hex="#FFFFFF"/>
    </brand-tokens>
    <layout-zones>
      <zone id="top-banner" position="top" height-pct="18" bg="brand-pink">
        <text language="it">3 DOMANDE · 3 RISPOSTE</text>
        <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
        <font-size-pct>8</font-size-pct><align>center</align>
      </zone>
      <zone id="body" position="middle" bg="brand-black" padding="40px 48px">
        <text-block alignment="left" line-spacing="1.4">
          <line emoji="💬">"Non ho tempo per 3 sere."</line>
          <line emoji="✅">30 min/sera. Replay incluso.</line>
          <line-break/>
          <line emoji="💬">"È un'altra dieta?"</line>
          <line emoji="✅">No. Niente piano alimentare. Solo metodo.</line>
          <line-break/>
          <line emoji="💬">"Mi vendi qualcosa di costoso?"</line>
          <line emoji="✅">Sì, il Club a €127 (una volta). Solo se vuoi.</line>
          <line-break/>
          <line emoji="🔥"><bold>Adesso lo sai.</bold> Lunedì 19/5 18.30 GRATIS.</line>
        </text-block>
        <font-color>brand-white</font-color><font-size-pct>4</font-size-pct>
      </zone>
      <zone id="scarcity-pill" position="bottom-right" margin-bottom="120px" margin-right="32px">
        <shape>pill rounded</shape><bg>brand-pink</bg><padding>8px 20px</padding>
        <text language="it">100 Posti</text>
        <font>Inter Bold</font><font-color>brand-white</font-color><font-size-pct>3.8</font-size-pct>
      </zone>
      <zone id="footer" position="bottom" height-pct="18" layout="split-50-50">
        <half side="left" bg="brand-pink">
          <text-line-1 language="it">Lunedì, 19</text-line-1>
          <text-line-2 language="it">MAGGIO 18.30</text-line-2>
          <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
          <font-size-pct>5.8</font-size-pct><align>center</align>
        </half>
        <half side="right" bg="brand-white">
          <text language="it">ISCRIVITI GRATIS</text>
          <font>Inter Black ALL-CAPS</font><font-color>brand-black</font-color>
          <font-size-pct>5.5</font-size-pct><align>center</align>
        </half>
      </zone>
    </layout-zones>
    <photo-asset use="false"/>
  </design-brief>

  <copy-for-meta-ads-manager>
    <primary-text language="it">
      <![CDATA[
3 domande, 3 risposte oneste:

💬 "Non ho tempo per 3 sere."
✅ 30 minuti a sera. Non di più. Replay incluso.

💬 "È un'altra dieta camuffata?"
✅ No. Non conto calorie. Non vieto cibi. Niente meal plan.

💬 "Poi mi vendi qualcosa di costoso?"
✅ Sì, ti parlerò del Club Inarrestabili. €127 una volta per sempre. Solo se vuoi continuare.

🔥 Adesso lo sai. WEBINAR GRATUITO Lunedì 19 Maggio 18.30.

100 posti.

Posto qui ↓
      ]]>
    </primary-text>
    <headline max-chars="40">3 domande, 3 risposte oneste.</headline>
    <description max-chars="30">FAQ webinar · onesto</description>
    <cta-button>SIGN_UP</cta-button>
    <variants>
      <headline-alt max-chars="40">Le 3 domande che mi fate.</headline-alt>
      <headline-alt max-chars="40">Onesto: ecco cosa aspettarsi.</headline-alt>
    </variants>
  </copy-for-meta-ads-manager>

  <destination>
    <landing-url>https://go.elenagiordani.com/webinar-maggio</landing-url>
    <utm>
      <utm_source>ig</utm_source><utm_medium>retargeting</utm_medium>
      <utm_campaign>estate-inarrestabile-2026-retarget-touch</utm_campaign>
      <utm_content>EI26-RTG-17v2-faq</utm_content>
      <utm_term>{{adset.name}}</utm_term>
    </utm>
    <full-url>https://go.elenagiordani.com/webinar-maggio?utm_source=ig&amp;utm_medium=retargeting&amp;utm_campaign=estate-inarrestabile-2026-retarget-touch&amp;utm_content=EI26-RTG-17v2-faq&amp;utm_term={{adset.name}}</full-url>
    <landing-variant-triggered>retarget-touch</landing-variant-triggered>
  </destination>

  <targeting>
    <audience-name>IT-RTG-Visitatori-NoOptin-30d</audience-name>
    <country>IT</country><gender>female</gender>
    <age-min>35</age-min><age-max>60</age-max>
    <custom-audiences>
      <audience>Visitatori go.elenagiordani.com/webinar-maggio 30gg (no Lead event)</audience>
    </custom-audiences>
    <exclusions>iscritti webinar, acquirenti Club</exclusions>
    <advantage-plus>false</advantage-plus>
    <placements>auto</placements>
  </targeting>

  <budget-and-kpi>
    <test-budget-eur-day>6</test-budget-eur-day>
    <test-duration-days>10</test-duration-days>
    <kpi-primary metric="CPL" target-max-eur="2.00"/>
    <kpi-secondary metric="CTR" target-min-pct="3.0"/>
    <kill-rule>Se CPL &gt; 4€ dopo 50€ spesi → off</kill-rule>
    <scale-rule>Se CPL ≤ 1.5€ → +25% budget</scale-rule>
    <frequency-cap>Max 4/settimana</frequency-cap>
  </budget-and-kpi>

  <notes>
    <note role="designer">Body alignment LEFT (non center) per leggibilità Q&amp;A. Pattern 💬→✅ ripetuto 3 volte = visual rhythm.</note>
    <note role="copywriter">Radical honesty Halbert. Menzionare prezzo Club (€127) pre-qualifica = filtra price-sensitive.</note>
    <note role="media-buyer">Story sequence drop-off = quale obiezione filtra. Iterare.</note>
  </notes>
</creative>
