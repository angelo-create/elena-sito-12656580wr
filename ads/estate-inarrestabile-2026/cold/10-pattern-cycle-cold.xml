<?xml version="1.0" encoding="UTF-8"?>
<creative id="EI26-COLD-10-v2" status="ready" priority="P1" version="winner-pattern-v2">
  <meta>
    <campaign>Estate Inarrestabile 2026</campaign>
    <objective>LEADS</objective>
    <funnel-stage>cold</funnel-stage>
    <angle>Pattern Cycle - "MAGGIO carica → SETTEMBRE indietro. STOP"</angle>
    <copy-framework>Pattern Recognition (winner pattern)</copy-framework>
    <design-template>winner-elena-v1</design-template>
  </meta>

  <design-brief output="canva-figma-static">
    <canvas><aspect-ratio>1:1</aspect-ratio><resolution>1080x1080</resolution><bg-base>brand-black</bg-base></canvas>
    <brand-tokens>
      <color name="brand-pink" hex="#FF0066"/>
      <color name="brand-black" hex="#000000"/>
      <color name="brand-white" hex="#FFFFFF"/>
    </brand-tokens>
    <layout-zones>
      <zone id="top-banner" position="top" height-pct="18" bg="brand-pink">
        <text language="it">WEBINAR PER DONNE</text>
        <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
        <font-size-pct>9</font-size-pct><align>center</align>
      </zone>
      <zone id="body" position="middle" bg="brand-black" padding="56px 56px">
        <text-block alignment="center" line-spacing="1.6">
          <line language="it" font-size-multiplier="1.4"><bold>MAGGIO</bold> carica.</line>
          <line language="it" font-size-multiplier="1.4"><bold>GIUGNO</bold> molli.</line>
          <line language="it" font-size-multiplier="1.4"><bold>SETTEMBRE</bold> indietro.</line>
          <line-break/>
          <line emoji="❌">È SEMPRE lo stesso schema.</line>
          <line-break/>
          <line emoji="🔥">Quest'estate cambi schema. <bold>WEBINAR GRATUITO</bold> Lunedì 19 Maggio 18.30!</line>
        </text-block>
        <font-color>brand-white</font-color><font-size-pct>5</font-size-pct>
      </zone>
      <zone id="scarcity-pill" position="bottom-right" margin-bottom="120px" margin-right="32px">
        <shape>pill rounded</shape><bg>brand-pink</bg><padding>8px 20px</padding>
        <text language="it">100 Posti</text>
        <font>Inter Bold</font><font-color>brand-white</font-color><font-size-pct>3.8</font-size-pct>
      </zone>
      <zone id="footer" position="bottom" height-pct="18" layout="split-50-50">
        <half side="left" bg="brand-pink">
          <text-line-1 language="it">Lunedì, 19</text-line-1>
          <text-line-2 language="it">MAGGIO 18.30</text-line-2>
          <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
          <font-size-pct>5.8</font-size-pct><align>center</align>
        </half>
        <half side="right" bg="brand-white">
          <text language="it">ISCRIVITI GRATIS</text>
          <font>Inter Black ALL-CAPS</font><font-color>brand-black</font-color>
          <font-size-pct>5.5</font-size-pct><align>center</align>
        </half>
      </zone>
    </layout-zones>
    <photo-asset use="false"/>
  </design-brief>

  <copy-for-meta-ads-manager>
    <primary-text language="it">
      <![CDATA[
MAGGIO carica.
GIUGNO molli.
SETTEMBRE indietro.

❌ È SEMPRE lo stesso schema. Da quanti anni? 5? 10? 20?

🔥 Quest'estate cambi schema. WEBINAR GRATUITO "Estate Inarrestabile" — 3 sere live, 19-20-21 maggio alle 18.30.

🔥 100 posti. Replay incluso.

Posto qui ↓
      ]]>
    </primary-text>
    <headline max-chars="40">Maggio→Giugno→Settembre. STOP.</headline>
    <description max-chars="30">Cambi schema · live gratis</description>
    <cta-button>SIGN_UP</cta-button>
    <variants>
      <headline-alt max-chars="40">Quest'estate cambi schema.</headline-alt>
      <headline-alt max-chars="40">Stesso ciclo da quanti anni?</headline-alt>
    </variants>
  </copy-for-meta-ads-manager>

  <destination>
    <landing-url>https://go.elenagiordani.com/webinar-maggio</landing-url>
    <utm>
      <utm_source>fb</utm_source><utm_medium>paid</utm_medium>
      <utm_campaign>estate-inarrestabile-2026-cold</utm_campaign>
      <utm_content>EI26-COLD-10v2-cycle</utm_content>
      <utm_term>{{adset.name}}</utm_term>
    </utm>
    <full-url>https://go.elenagiordani.com/webinar-maggio?utm_source=fb&amp;utm_medium=paid&amp;utm_campaign=estate-inarrestabile-2026-cold&amp;utm_content=EI26-COLD-10v2-cycle&amp;utm_term={{adset.name}}</full-url>
  </destination>

  <targeting>
    <audience-name>IT-Donne-35-55-YoYo-Pattern-Cold</audience-name>
    <country>IT</country><gender>female</gender>
    <age-min>35</age-min><age-max>55</age-max>
    <interests>dieta yo-yo, perdita peso, prova costume, vacanze estive, mantenere peso</interests>
    <exclusions>visitatori webinar-maggio.html 30gg, acquirenti Club</exclusions>
    <advantage-plus>true</advantage-plus>
    <placements>auto</placements>
  </targeting>

  <budget-and-kpi>
    <test-budget-eur-day>12</test-budget-eur-day>
    <test-duration-days>4</test-duration-days>
    <kpi-primary metric="CPL" target-max-eur="3.50"/>
    <kpi-secondary metric="CTR" target-min-pct="2.0"/>
    <kill-rule>Se CPL &gt; 5.5€ dopo 60€ spesi → off</kill-rule>
    <scale-rule>Se CPL ≤ 3€ → +25% budget</scale-rule>
  </budget-and-kpi>

  <notes>
    <note role="designer">Tipografia ritmica MAGGIO/GIUGNO/SETTEMBRE in 3 righe = pattern visivo forte. Bold sui 3 mesi.</note>
    <note role="copywriter">Pattern recognition immediato. "STOP" implicito nello schema rotto.</note>
    <note role="media-buyer">Audience yo-yo-aware. Self-recognition forte attesa.</note>
  </notes>
</creative>
