<?xml version="1.0" encoding="UTF-8"?>
<creative id="EI26-COLD-07-v2" status="ready" priority="P0" version="winner-pattern-v2">
  <meta>
    <campaign>Estate Inarrestabile 2026</campaign>
    <objective>LEADS</objective>
    <funnel-stage>cold</funnel-stage>
    <angle>Primo Passo Curiosity - "Qual è il PRIMO PASSO per essere costante?"</angle>
    <copy-framework>Curiosity Loop (winner pattern)</copy-framework>
    <design-template>winner-elena-v1</design-template>
  </meta>

  <design-brief output="canva-figma-static">
    <canvas><aspect-ratio>1:1</aspect-ratio><resolution>1080x1080</resolution><bg-base>brand-black</bg-base></canvas>
    <brand-tokens>
      <color name="brand-pink" hex="#FF0066"/>
      <color name="brand-black" hex="#000000"/>
      <color name="brand-white" hex="#FFFFFF"/>
    </brand-tokens>
    <layout-zones>
      <zone id="top-banner" position="top" height-pct="18" bg="brand-pink">
        <text language="it">WEBINAR PER DONNE</text>
        <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
        <font-size-pct>9</font-size-pct><align>center</align>
      </zone>
      <zone id="body" position="middle" bg="brand-black" padding="48px 56px">
        <text-block alignment="center" line-spacing="1.5">
          <line emoji="❓">Qual è il <bold>PRIMO PASSO</bold> per essere COSTANTE quest'estate?</line>
          <line-break/>
          <line emoji="❌">NO, non è la motivazione.</line>
          <line emoji="❌">NO, non è la disciplina.</line>
          <line emoji="❌">NO, non è iscriverti in palestra.</line>
          <line-break/>
          <line emoji="💡">Te lo svelo nel <bold>WEBINAR GRATUITO</bold> di Lunedì 19 Maggio 2026 alle 18.30!</line>
        </text-block>
        <font-color>brand-white</font-color><font-size-pct>4.7</font-size-pct>
      </zone>
      <zone id="scarcity-pill" position="bottom-right" margin-bottom="120px" margin-right="32px">
        <shape>pill rounded</shape><bg>brand-pink</bg><padding>8px 20px</padding>
        <text language="it">100 Posti</text>
        <font>Inter Bold</font><font-color>brand-white</font-color><font-size-pct>3.8</font-size-pct>
      </zone>
      <zone id="footer" position="bottom" height-pct="18" layout="split-50-50">
        <half side="left" bg="brand-pink">
          <text-line-1 language="it">Lunedì, 19</text-line-1>
          <text-line-2 language="it">MAGGIO 18.30</text-line-2>
          <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
          <font-size-pct>5.8</font-size-pct><align>center</align>
        </half>
        <half side="right" bg="brand-white">
          <text language="it">ISCRIVITI GRATIS</text>
          <font>Inter Black ALL-CAPS</font><font-color>brand-black</font-color>
          <font-size-pct>5.5</font-size-pct><align>center</align>
        </half>
      </zone>
    </layout-zones>
    <photo-asset use="false"/>
  </design-brief>

  <copy-for-meta-ads-manager>
    <primary-text language="it">
      <![CDATA[
❓ Qual è il PRIMO PASSO per essere costante quest'estate?

❌ NON è la motivazione.
❌ NON è la disciplina.
❌ NON è iscriverti in palestra.

💡 Te lo svelo nel WEBINAR GRATUITO "Estate Inarrestabile" — 3 sere live, 19-20-21 maggio alle 18.30. Spoiler: è una cosa che chi vende metodi NON vuole che tu sappia.

🔥 100 posti. Replay incluso.

Posto qui ↓
      ]]>
    </primary-text>
    <headline max-chars="40">Il PRIMO PASSO non è quello.</headline>
    <description max-chars="30">Spoiler: NON è la motivazione</description>
    <cta-button>SIGN_UP</cta-button>
    <variants>
      <headline-alt max-chars="40">Spoiler: NON è la motivazione.</headline-alt>
      <headline-alt max-chars="40">Cos'è il vero PRIMO PASSO?</headline-alt>
    </variants>
  </copy-for-meta-ads-manager>

  <destination>
    <landing-url>https://go.elenagiordani.com/webinar-maggio</landing-url>
    <utm>
      <utm_source>fb</utm_source><utm_medium>paid</utm_medium>
      <utm_campaign>estate-inarrestabile-2026-cold</utm_campaign>
      <utm_content>EI26-COLD-07v2-primopasso</utm_content>
      <utm_term>{{adset.name}}</utm_term>
    </utm>
    <full-url>https://go.elenagiordani.com/webinar-maggio?utm_source=fb&amp;utm_medium=paid&amp;utm_campaign=estate-inarrestabile-2026-cold&amp;utm_content=EI26-COLD-07v2-primopasso&amp;utm_term={{adset.name}}</full-url>
  </destination>

  <targeting>
    <audience-name>IT-Donne-35-55-Curiosity-Habits-Cold</audience-name>
    <country>IT</country><gender>female</gender>
    <age-min>35</age-min><age-max>55</age-max>
    <interests>abitudini, atomic habits, mindset, libri self help, James Clear, motivazione</interests>
    <exclusions>visitatori webinar-maggio.html 30gg, acquirenti Club</exclusions>
    <advantage-plus>true</advantage-plus>
    <placements>auto</placements>
  </targeting>

  <budget-and-kpi>
    <test-budget-eur-day>15</test-budget-eur-day>
    <test-duration-days>4</test-duration-days>
    <kpi-primary metric="CPL" target-max-eur="3.00"/>
    <kpi-secondary metric="CTR" target-min-pct="2.2"/>
    <kpi-secondary metric="hook-rate-3s" target-min-pct="35"/>
    <kill-rule>Se hook-rate &lt; 25% dopo 50€ spesi → off</kill-rule>
    <scale-rule>Se CPL ≤ 2.5€ → +30% budget</scale-rule>
  </budget-and-kpi>

  <notes>
    <note role="designer">Stesso template winner. Lista "NO" con ❌ ripetuto = visual rhythm forte.</note>
    <note role="copywriter">Curiosity loop classico: 3 negazioni + cliffhanger. Tema "primo passo" = topic centrale del webinar (richiesta cliente).</note>
    <note role="media-buyer">Curiosity creative = alto hook-rate. Misurare attentamente click-through.</note>
  </notes>
</creative>
