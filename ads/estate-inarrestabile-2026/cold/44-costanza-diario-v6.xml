  <targeting>
    <audience-name>IT-Donne-40-58-Tracking-Bullet-Cold</audience-name>
    <country>IT</country><gender>female</gender>
    <age-min>40</age-min><age-max>58</age-max>
    <interests>bullet journal, journaling, productivity, app fitness tracking, MyFitnessPal, Notion</interests>
    <exclusions>visitatori webinar-maggio.html 30gg, acquirenti Club</exclusions>
    <advantage-plus>true</advantage-plus>
    <placements>auto</placements>
  </targeting>

  <budget-and-kpi>
    <test-budget-eur-day>12</test-budget-eur-day>
    <test-duration-days>4</test-duration-days>
    <kpi-primary metric="CPL" target-max-eur="2.50"/>
    <kpi-secondary metric="CTR" target-min-pct="2.2"/>
    <kill-rule>Se CPL &gt; 4€ dopo 50€ spesi → off</kill-rule>
    <scale-rule>Se CPL ≤ 2€ → +30% budget</scale-rule>
  </budget-and-kpi>

  <notes>
    <note role="image-generator">Notebook aperto, contrasto pagine scritte vs vuote visible.</note>
    <note role="copywriter">Specifity numerica (pagine 1-2-3-4 + bianco). Reframe: tracking ossessivo NON serve.</note>
    <note role="designer">Highlight pink su "Bianco" = il vuoto.</note>
