💡 In 3 sere live ti spiego come si fa. Lunedi 19 Maggio 18.30. Live, gratis.

🔥 100 posti.

Posto qui ↓
      ]]>
    </primary-text>
    <headline max-chars="40">Diario alimentare. Bianco da pag 5</headline>
    <description max-chars="30">Stop al tracciamento ossessivo</description>
    <cta-button>SIGN_UP</cta-button>
    <variants>
      <headline-alt max-chars="40">4 giorni e poi l'oblio.</headline-alt>
      <headline-alt max-chars="40">Quanti diari abbandonati?</headline-alt>
    </variants>
  </copy-for-meta-ads-manager>

  <destination>
    <landing-url>https://go.elenagiordani.com/webinar-maggio</landing-url>
    <utm>
      <utm_source>fb</utm_source><utm_medium>paid</utm_medium>
      <utm_campaign>estate-inarrestabile-2026-cold</utm_campaign>
      <utm_content>EI26-COLD-44v6-diario</utm_content>
      <utm_term>{{adset.name}}</utm_term>
    </utm>
    <full-url>https://go.elenagiordani.com/webinar-maggio?utm_source=fb&amp;utm_medium=paid&amp;utm_campaign=estate-inarrestabile-2026-cold&amp;utm_content=EI26-COLD-44v6-diario&amp;utm_term={{adset.name}}</full-url>
