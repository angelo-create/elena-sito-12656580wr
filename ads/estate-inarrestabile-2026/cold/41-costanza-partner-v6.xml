<?xml version="1.0" encoding="UTF-8"?>
<creative id="EI26-COLD-41-v6-partner" status="ready" priority="P0" version="winner-pattern-v6-costanza-40plus">
  <meta>
    <campaign>Estate Inarrestabile 2026</campaign>
    <objective>LEADS</objective>
    <funnel-stage>cold</funnel-stage>
    <angle>Il Partner Non Collabora - mangia diversamente, sabota</angle>
    <pain-targeted>Marito/partner che mangia patatine sul divano mentre tu cerchi di mangiare sano</pain-targeted>
    <copy-framework>Pain-Direct + Relationship Sabotage Recognition</copy-framework>
    <design-template>v6-brand-pain-costanza</design-template>
  </meta>

  <image-generation>
    <model>gpt-image-2 (via Higgsfield)</model>
    <reference-images>
      <ref id="elena-higgsfield" required="true">Reference Elena caricate in Higgsfield</ref>
    </reference-images>
    <prompt-elaborate language="en">
      <![CDATA[
A 45-year-old Italian woman (use Elena Higgsfield reference) sitting on her sofa or kitchen, looking at camera with a knowing direct expression and slight playful smirk - "yes my husband does this too" coach energy. NO partner visible in frame.

She wears comfortable home clothes. Clean modern Italian living room or kitchen, soft daylight.

CRITICAL STYLE: PRACTICAL coach moment, NOT cinematic. Real Italian woman 45.

Composition: Elena center frame chest up, plenty of negative space top/bottom for brand overlay.
      ]]>
    </prompt-elaborate>
    <negative-prompt>cinematic editorial, dramatic, sad, golden hour, model thin, instagram filter, makeup heavy, partner visible in frame, romantic couple, fight scene</negative-prompt>
    <output-specs><aspect-ratio>1:1</aspect-ratio><resolution>1080x1080</resolution><variations-to-generate>4</variations-to-generate></output-specs>
  </image-generation>

  <design-brief output="canva-figma-static">
    <canvas><aspect-ratio>1:1</aspect-ratio><resolution>1080x1080</resolution><bg-base>foto-elena</bg-base></canvas>
    <brand-tokens>
      <color name="brand-pink" hex="#FF0066"/>
      <color name="brand-black" hex="#000000"/>
      <color name="brand-white" hex="#FFFFFF"/>
    </brand-tokens>
    <layout-zones>
      <zone id="top-banner" position="top" height-pct="18" bg="brand-pink" z-index="2">
        <text language="it">WEBINAR PER DONNE 40+</text>
        <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
        <font-size-pct>8</font-size-pct><align>center</align>
      </zone>
      <zone id="photo-area" position="middle" height-pct="64" z-index="1">
        <photo>foto Elena (full width, cover)</photo>
        <gradient-overlay-bottom>linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 50%)</gradient-overlay-bottom>
      </zone>
      <zone id="headline-overlay" position="lower-middle-on-photo" margin-bottom="32px" padding="0 32px" z-index="3">
        <text-block alignment="center" line-spacing="1.3">
          <line emoji="🍿">Lui mangia patatine</line>
          <line>sul divano <highlight bg="brand-pink" color="brand-white" padding="2px 8px">accanto a te</highlight>.</line>
          <line>Tu cosa fai?</line>
        </text-block>
        <font>Inter Black</font>
        <font-color>brand-white</font-color>
        <text-shadow>0 2px 12px rgba(0,0,0,0.5)</text-shadow>
        <font-size-pct>5.5</font-size-pct>
      </zone>
      <zone id="scarcity-pill" position="bottom-right" margin-bottom="120px" margin-right="24px" z-index="3">
        <shape>pill rounded</shape><bg>brand-pink</bg><padding>6px 16px</padding>
        <text language="it">100 Posti</text>
        <font>Inter Bold</font><font-color>brand-white</font-color><font-size-pct>3.5</font-size-pct>
      </zone>
      <zone id="footer" position="bottom" height-pct="18" layout="split-50-50" z-index="2">
        <half side="left" bg="brand-pink">
          <text-line-1 language="it">Lunedi, 19</text-line-1>
          <text-line-2 language="it">MAGGIO 18.30</text-line-2>
          <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
          <font-size-pct>5.8</font-size-pct><align>center</align>
        </half>
        <half side="right" bg="brand-white">
          <text language="it">ISCRIVITI GRATIS</text>
          <font>Inter Black ALL-CAPS</font><font-color>brand-black</font-color>
          <font-size-pct>5.5</font-size-pct><align>center</align>
        </half>
      </zone>
    </layout-zones>
  </design-brief>

  <copy-for-meta-ads-manager>
    <primary-text language="it">
      <![CDATA[
🍿 Lui mangia patatine sul divano accanto a te. Tu cosa fai?

Sera 1: resisti.
Sera 2: una. "Tanto e una".
Sera 3: ne mangi tre.
Sera 4: hai mollato.

❌ Non e lui che ti sabota.
❌ Non sei tu che sei "debole".
✅ E che ti hanno venduto un metodo che funziona solo se vivi sola in un convento.

💡 In 3 sere live ti spiego il METODO che funziona ANCHE se il partner mangia diversamente. Lunedi 19 Maggio 18.30. Live, gratis.

🔥 100 posti.

Posto qui ↓
      ]]>
    </primary-text>
    <headline max-chars="40">Lui mangia patatine accanto a te.</headline>
    <description max-chars="30">Metodo a casa con partner</description>
    <cta-button>SIGN_UP</cta-button>
    <variants>
      <headline-alt max-chars="40">Il partner che ti "sabota".</headline-alt>
      <headline-alt max-chars="40">Vivi col partner. Non in convento.</headline-alt>
    </variants>
  </copy-for-meta-ads-manager>

  <destination>
    <landing-url>https://go.elenagiordani.com/webinar-maggio</landing-url>
    <utm>
      <utm_source>fb</utm_source><utm_medium>paid</utm_medium>
      <utm_campaign>estate-inarrestabile-2026-cold</utm_campaign>
      <utm_content>EI26-COLD-41v6-partner</utm_content>
      <utm_term>{{adset.name}}</utm_term>
    </utm>
    <full-url>https://go.elenagiordani.com/webinar-maggio?utm_source=fb&amp;utm_medium=paid&amp;utm_campaign=estate-inarrestabile-2026-cold&amp;utm_content=EI26-COLD-41v6-partner&amp;utm_term={{adset.name}}</full-url>
  </destination>

  <targeting>
    <audience-name>IT-Donne-40-58-Coppia-Cold</audience-name>
    <country>IT</country><gender>female</gender>
    <age-min>40</age-min><age-max>58</age-max>
    <interests>vita di coppia, matrimonio, relazioni, famiglia, cucina coppia</interests>
    <relationship-status>married, engaged, in_relationship</relationship-status>
    <exclusions>visitatori webinar-maggio.html 30gg, acquirenti Club</exclusions>
    <advantage-plus>true</advantage-plus>
    <placements>auto</placements>
  </targeting>

  <budget-and-kpi>
    <test-budget-eur-day>12</test-budget-eur-day>
    <test-duration-days>4</test-duration-days>
    <kpi-primary metric="CPL" target-max-eur="2.50"/>
    <kpi-secondary metric="CTR" target-min-pct="2.5"/>
    <kill-rule>Se CPL &gt; 4€ dopo 50€ spesi → off</kill-rule>
    <scale-rule>Se CPL ≤ 2€ → +30% budget</scale-rule>
  </budget-and-kpi>

  <notes>
    <note role="image-generator">Elena espressione knowing direct + smirk. Partner NON visibile (per inclusivita).</note>
    <note role="copywriter">Cronologia 4 sere divano. Reframe brillante: "non vivi sola in convento".</note>
    <note role="designer">Highlight pink su "accanto a te" = la prossimita = il problema.</note>
  </notes>
</creative>
