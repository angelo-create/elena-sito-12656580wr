<?xml version="1.0" encoding="UTF-8"?>
<creative id="EI26-WARM-11-v2" status="ready" priority="P0" version="winner-pattern-v2">
  <meta>
    <campaign>Estate Inarrestabile 2026</campaign>
    <objective>LEADS</objective>
    <funnel-stage>warm</funnel-stage>
    <angle>Direct Address Warm - "Mi conosci. Stavolta è il momento."</angle>
    <copy-framework>Direct Address Tribale (winner pattern)</copy-framework>
    <design-template>winner-elena-v1</design-template>
  </meta>

  <design-brief output="canva-figma-static">
    <canvas><aspect-ratio>1:1</aspect-ratio><resolution>1080x1080</resolution><bg-base>brand-black</bg-base></canvas>
    <brand-tokens>
      <color name="brand-pink" hex="#FF0066"/>
      <color name="brand-black" hex="#000000"/>
      <color name="brand-white" hex="#FFFFFF"/>
    </brand-tokens>
    <layout-zones>
      <zone id="top-banner" position="top" height-pct="18" bg="brand-pink">
        <text language="it">WEBINAR PER LE INARRESTABILI</text>
        <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
        <font-size-pct>7</font-size-pct><align>center</align>
      </zone>
      <zone id="body" position="middle" bg="brand-black" padding="48px 56px">
        <text-block alignment="center" line-spacing="1.5">
          <line emoji="💜">Mi conosci da un po'.</line>
          <line-break/>
          <line>Hai messo qualche like, salvato qualche post, pensato "magari la prossima".</line>
          <line-break/>
          <line><bold>Stavolta è il momento.</bold></line>
          <line-break/>
          <line emoji="✅">Lunedì 19 Maggio 18.30 — <bold>WEBINAR GRATUITO</bold> "Estate Inarrestabile"</line>
        </text-block>
        <font-color>brand-white</font-color><font-size-pct>4.6</font-size-pct>
      </zone>
      <zone id="scarcity-pill" position="bottom-right" margin-bottom="120px" margin-right="32px">
        <shape>pill rounded</shape><bg>brand-pink</bg><padding>8px 20px</padding>
        <text language="it">100 Posti</text>
        <font>Inter Bold</font><font-color>brand-white</font-color><font-size-pct>3.8</font-size-pct>
      </zone>
      <zone id="footer" position="bottom" height-pct="18" layout="split-50-50">
        <half side="left" bg="brand-pink">
          <text-line-1 language="it">Lunedì, 19</text-line-1>
          <text-line-2 language="it">MAGGIO 18.30</text-line-2>
          <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
          <font-size-pct>5.8</font-size-pct><align>center</align>
        </half>
        <half side="right" bg="brand-white">
          <text language="it">ISCRIVITI GRATIS</text>
          <font>Inter Black ALL-CAPS</font><font-color>brand-black</font-color>
          <font-size-pct>5.5</font-size-pct><align>center</align>
        </half>
      </zone>
    </layout-zones>
    <photo-asset use="false"/>
  </design-brief>

  <copy-for-meta-ads-manager>
    <primary-text language="it">
      <![CDATA[
💜 Mi conosci da un po'.

Hai messo qualche like. Salvato qualche post. Hai pensato "magari la prossima".

Stavolta è il momento. Senza giri.

✅ WEBINAR GRATUITO "Estate Inarrestabile" — 3 sere live, 19-20-21 maggio alle 18.30. 30 minuti l'una. Replay incluso.

🔥 100 posti.

Posto qui ↓
      ]]>
    </primary-text>
    <headline max-chars="40">Stavolta è il momento. Senza giri.</headline>
    <description max-chars="30">Per chi mi segue · gratis</description>
    <cta-button>SIGN_UP</cta-button>
    <variants>
      <headline-alt max-chars="40">Quante volte ancora "magari"?</headline-alt>
      <headline-alt max-chars="40">Tra noi: stavolta entra.</headline-alt>
    </variants>
  </copy-for-meta-ads-manager>

  <destination>
    <landing-url>https://go.elenagiordani.com/webinar-maggio</landing-url>
    <utm>
      <utm_source>fb</utm_source><utm_medium>paid</utm_medium>
      <utm_campaign>estate-inarrestabile-2026-warm</utm_campaign>
      <utm_content>EI26-WARM-11v2-miconosci</utm_content>
      <utm_term>{{adset.name}}</utm_term>
    </utm>
    <full-url>https://go.elenagiordani.com/webinar-maggio?utm_source=fb&amp;utm_medium=paid&amp;utm_campaign=estate-inarrestabile-2026-warm&amp;utm_content=EI26-WARM-11v2-miconosci&amp;utm_term={{adset.name}}</full-url>
  </destination>

  <targeting>
    <audience-name>IT-Engagers-180d + Newsletter-Subscribers</audience-name>
    <country>IT</country><gender>female</gender>
    <age-min>35</age-min><age-max>60</age-max>
    <custom-audiences>
      <audience>Engagers FB+IG 180gg</audience>
      <audience>Newsletter subscribers ultimi 365gg</audience>
      <audience>LAL 1% acquirenti Club</audience>
    </custom-audiences>
    <exclusions>visitatori webinar-maggio.html 14gg, acquirenti Club</exclusions>
    <advantage-plus>true</advantage-plus>
    <placements>auto</placements>
  </targeting>

  <budget-and-kpi>
    <test-budget-eur-day>15</test-budget-eur-day>
    <test-duration-days>5</test-duration-days>
    <kpi-primary metric="CPL" target-max-eur="2.00"/>
    <kpi-secondary metric="CTR" target-min-pct="2.5"/>
    <kill-rule>Se CPL &gt; 4€ dopo 70€ spesi → off</kill-rule>
    <scale-rule>Se CPL ≤ 1.5€ → +30% budget</scale-rule>
  </budget-and-kpi>

  <notes>
    <note role="designer">Top banner ESPECIFICO "PER LE INARRESTABILI" (warm = già parte tribù).</note>
    <note role="copywriter">Direct address al follower. Naming dell'esitazione ("magari la prossima") = mind-reading.</note>
    <note role="media-buyer">Warm CPL atteso ≤2€. Audience ristretta.</note>
  </notes>
</creative>
