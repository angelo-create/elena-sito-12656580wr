<?xml version="1.0" encoding="UTF-8"?>
<creative id="EI26-WARM-14-v2" status="ready" priority="P1" version="winner-pattern-v2">
  <meta>
    <campaign>Estate Inarrestabile 2026</campaign>
    <objective>LEADS</objective>
    <funnel-stage>warm</funnel-stage>
    <angle>Salento Story - "L'estate dei 42 anni mi ha insegnato"</angle>
    <copy-framework>Story-led Short (winner pattern adattato)</copy-framework>
    <design-template>winner-elena-v1</design-template>
  </meta>

  <design-brief output="canva-figma-static">
    <canvas><aspect-ratio>1:1</aspect-ratio><resolution>1080x1080</resolution><bg-base>brand-black</bg-base></canvas>
    <brand-tokens>
      <color name="brand-pink" hex="#FF0066"/>
      <color name="brand-black" hex="#000000"/>
      <color name="brand-white" hex="#FFFFFF"/>
    </brand-tokens>
    <layout-zones>
      <zone id="top-banner" position="top" height-pct="18" bg="brand-pink">
        <text language="it">WEBINAR PER DONNE</text>
        <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
        <font-size-pct>9</font-size-pct><align>center</align>
      </zone>
      <zone id="body" position="middle" bg="brand-black" padding="48px 56px">
        <text-block alignment="center" line-spacing="1.5">
          <line emoji="💬">"L'estate dei <bold>42 anni</bold> mi ha insegnato una cosa che ha cambiato tutto."</line>
          <line-break/>
          <line>Era luglio. Ero in Salento. Davanti allo specchio.</line>
          <line-break/>
          <line>Quel pomeriggio ho capito quello che 2300+ donne hanno poi capito con me.</line>
          <line-break/>
          <line emoji="💡">Te lo racconto live nel <bold>WEBINAR GRATUITO</bold> di Lunedì 19 Maggio 18.30!</line>
        </text-block>
        <font-color>brand-white</font-color><font-size-pct>4.6</font-size-pct>
      </zone>
      <zone id="scarcity-pill" position="bottom-right" margin-bottom="120px" margin-right="32px">
        <shape>pill rounded</shape><bg>brand-pink</bg><padding>8px 20px</padding>
        <text language="it">100 Posti</text>
        <font>Inter Bold</font><font-color>brand-white</font-color><font-size-pct>3.8</font-size-pct>
      </zone>
      <zone id="footer" position="bottom" height-pct="18" layout="split-50-50">
        <half side="left" bg="brand-pink">
          <text-line-1 language="it">Lunedì, 19</text-line-1>
          <text-line-2 language="it">MAGGIO 18.30</text-line-2>
          <font>Inter Black ALL-CAPS</font><font-color>brand-white</font-color>
          <font-size-pct>5.8</font-size-pct><align>center</align>
        </half>
        <half side="right" bg="brand-white">
          <text language="it">ISCRIVITI GRATIS</text>
          <font>Inter Black ALL-CAPS</font><font-color>brand-black</font-color>
          <font-size-pct>5.5</font-size-pct><align>center</align>
        </half>
      </zone>
    </layout-zones>
    <photo-asset use="false"/>
  </design-brief>

  <copy-for-meta-ads-manager>
    <primary-text language="it">
      <![CDATA[
💬 "L'estate dei 42 anni mi ha insegnato una cosa che ha cambiato tutto."

Era luglio. Ero in una casa in affitto in Salento. Davanti allo specchio del bagno.

Quel pomeriggio ho capito quello che 2300+ donne 35+ hanno poi capito con me. Non era la disciplina. Non era la motivazione. Era una cosa più semplice — e più scomoda.

💡 Te lo racconto nel WEBINAR GRATUITO "Estate Inarrestabile" — 3 sere live, 19-20-21 maggio alle 18.30.

🔥 100 posti. Replay incluso.

Posto qui ↓
      ]]>
    </primary-text>
    <headline max-chars="40">L'estate dei 42 anni in Salento.</headline>
    <description max-chars="30">Te lo racconto live · gratis</description>
    <cta-button>SIGN_UP</cta-button>
    <variants>
      <headline-alt max-chars="40">Quel pomeriggio in Salento.</headline-alt>
      <headline-alt max-chars="40">42 anni. Una cosa scomoda.</headline-alt>
    </variants>
  </copy-for-meta-ads-manager>

  <destination>
    <landing-url>https://go.elenagiordani.com/webinar-maggio</landing-url>
    <utm>
      <utm_source>fb</utm_source><utm_medium>paid</utm_medium>
      <utm_campaign>estate-inarrestabile-2026-warm</utm_campaign>
      <utm_content>EI26-WARM-14v2-salento</utm_content>
      <utm_term>{{adset.name}}</utm_term>
    </utm>
    <full-url>https://go.elenagiordani.com/webinar-maggio?utm_source=fb&amp;utm_medium=paid&amp;utm_campaign=estate-inarrestabile-2026-warm&amp;utm_content=EI26-WARM-14v2-salento&amp;utm_term={{adset.name}}</full-url>
  </destination>

  <targeting>
    <audience-name>IT-Engagers-180d-Storytelling</audience-name>
    <country>IT</country><gender>female</gender>
    <age-min>40</age-min><age-max>60</age-max>
    <custom-audiences>
      <audience>Engagers FB+IG 180gg</audience>
      <audience>Video viewers 50%+ ultimi 90gg</audience>
    </custom-audiences>
    <exclusions>visitatori webinar-maggio.html 14gg, acquirenti Club</exclusions>
    <advantage-plus>true</advantage-plus>
    <placements>auto</placements>
  </targeting>

  <budget-and-kpi>
    <test-budget-eur-day>10</test-budget-eur-day>
    <test-duration-days>5</test-duration-days>
    <kpi-primary metric="CPL" target-max-eur="2.50"/>
    <kpi-secondary metric="CTR" target-min-pct="2.0"/>
    <kpi-secondary metric="time-on-ad" target-min-sec="6"/>
    <kill-rule>Se CPL &gt; 4€ dopo 50€ spesi → off</kill-rule>
    <scale-rule>Se CPL ≤ 2€ → +25% budget</scale-rule>
  </budget-and-kpi>

  <notes>
    <note role="designer">Story emoji 💬 = quote. Bold strategico su "42 anni" e parole chiave. Layout standard ma copy diverso.</note>
    <note role="copywriter">Story-led ridotto a 6 righe (vs v1 long-copy). Mantiene cliffhanger. Verifica con Elena se episodio Salento è autentico.</note>
    <note role="media-buyer">Story warm. Aspettarsi alto time-on-ad.</note>
  </notes>
</creative>
