{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/risorse-gratuite",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/webinar-coach",
      "has": [{ "type": "host", "value": "(?!go\\.elenagiordani\\.com).*" }],
      "destination": "https://go.elenagiordani.com/webinar-coach",
      "permanent": true
    },
    {
      "source": "/webinar-marzo",
      "has": [{ "type": "host", "value": "(?!go\\.elenagiordani\\.com).*" }],
      "destination": "https://go.elenagiordani.com/webinar-marzo",
      "permanent": true
    },
    {
      "source": "/evento-maggio",
      "has": [{ "type": "host", "value": "(?!go\\.elenagiordani\\.com).*" }],
      "destination": "https://go.elenagiordani.com/evento-maggio",
      "permanent": true
    },
    {
      "source": "/webinar-maggio",
      "has": [{ "type": "host", "value": "(?!go\\.elenagiordani\\.com).*" }],
      "destination": "https://go.elenagiordani.com/webinar-maggio",
      "permanent": true
    },
    {
      "source": "/lunedi-inarrestabili",
      "has": [{ "type": "host", "value": "(?!go\\.elenagiordani\\.com).*" }],
      "destination": "https://go.elenagiordani.com/lunedi-inarrestabili",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "go.elenagiordani.com" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
